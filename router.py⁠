import json

class MockKubernetesOrchestrator:
    def generate_k8s_manifest(self, task_name, target_region, compute_power_kw):
        """Генерирует манифест пода с привязкой к целевому региону"""
        return {
            "apiVersion": "v1",
            "kind": "Pod",
            "metadata": {"name": f"gridflow-{task_name}"},
            "spec": {
                "containers": [{
                    "name": "cuda-compute-payload",
                    "image": "gridflow-ai/compute-worker:latest",
                    "resources": {"limits": {"nvidia.com/gpu": 1}}
                }],
                "nodeSelector": {
                    "topology.kubernetes.io/region": target_region
                }
            }
        }

    def deploy_to_cluster(self, manifest):
        """Симулирует отправку манифеста в API Kubernetes кластера"""
        region = manifest["spec"]["nodeSelector"]["topology.kubernetes.io/region"]
        return {
            "status": "success",
            "status_code": 200,
            "message": f"Successfully orchestrated deployment to region: {region}"
        }

class HeuristicComputeRouter:
    def __init__(self, config_path):
        self.config_path = config_path
        with open(config_path, 'r', encoding='utf-8') as f:
            self.config = json.load(f)
        self.orchestrator = MockKubernetesOrchestrator()

    def find_optimal_region(self, current_region, latency_threshold_ms, compute_power_kw, run_hours, checkpoint_size_gb=0, max_total_time_hours=None):
        regions = self.config.get("regions", {})
        current_data = regions.get(current_region)
        if not current_data:
            return {"target_region": current_region, "estimated_savings_usd": 0.0, "migration_time_hours": 0.0}
            
        current_price = current_data.get("energy_price_kwh", 0.0)
        current_cost = compute_power_kw * run_hours * current_price
        
        best_region = current_region
        min_cost = current_cost
        final_migration_time = 0.0
        
        for r_id, r_data in regions.items():
            if r_data.get("latency_to_origin_ms", 9999) > latency_threshold_ms:
                continue
                
            migration_time_hours = 0.0
            if r_id != current_region and checkpoint_size_gb > 0:
                speed_mbps = r_data.get("network_speed_mbps", 100)
                migration_time_hours = (checkpoint_size_gb * 8000) / (speed_mbps * 3600)
            
            if max_total_time_hours and (run_hours + migration_time_hours) > max_total_time_hours:
                continue
                
            price = r_data.get("energy_price_kwh", 0.0)
            cost = compute_power_kw * run_hours * price
            
            if cost < min_cost:
                min_cost = cost
                best_region = r_id
                final_migration_time = migration_time_hours
                    
        savings = current_cost - min_cost
        return {
            "target_region": best_region,
            "estimated_savings_usd": round(float(savings), 2),
            "migration_time_hours": round(final_migration_time, 2)
        }
        
    def trigger_active_migration(self, task_name, current_region, latency_threshold_ms, compute_power_kw, run_hours, checkpoint_size_gb=0, max_total_time_hours=None):
        """Находит регион и сразу запускает оркестрацию в K8s"""
        decision = self.find_optimal_region(current_region, latency_threshold_ms, compute_power_kw, run_hours, checkpoint_size_gb, max_total_time_hours)
        manifest = self.orchestrator.generate_k8s_manifest(task_name, decision["target_region"], compute_power_kw)
        deployment_result = self.orchestrator.deploy_to_cluster(manifest)
        
        return {
            "decision": decision,
            "k8s_manifest": manifest,
            "orchestration_status": deployment_result
        }
